# API; use a disposable local DB for tests, never production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tcg?pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/tcg"
SECRET_JWT="replace-with-at-least-32-random-characters"
CLIENT_URL="http://localhost:3000"
PORT=8080
GOOGLE_CLIENT_ID=""
# Set only for isolated tests / manually operated staging.
DISABLE_BACKGROUND_JOBS=false

# Transactional account recovery (server-only)
WEB_URL="http://localhost:3000"
RESEND_KEY=""
EMAIL_FROM=""
